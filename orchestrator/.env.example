# Copy to .env next to docker-compose.yml and fill in real values.
# Never commit the real .env.

# Admin key — used only to mint/revoke per-user virtual keys and to view
# fleet-wide usage. Not the key you hand out to students/profs.
LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-string

# Postgres password for the proxy's own key/usage-tracking DB.
POSTGRES_PASSWORD=change-me

# --- Keycloak (AD-gated SSO login) — see docs/ADMIN_SSO_SETUP.md -----------
# Separate DB password for Keycloak's own postgres instance.
KEYCLOAK_DB_PASSWORD=change-me-too
# Keycloak admin console login (http://<gateway-host>:8080), setup only —
# not something you hand out.
KEYCLOAK_ADMIN_PASSWORD=change-me-again
# The realm you create in Keycloak for this proxy (docs use "cis-ai-fleet").
KEYCLOAK_REALM=cis-ai-fleet

# --- LiteLLM proxy SSO (generic OIDC, points at the Keycloak realm above) --
# Public URL people actually hit — used to build the SSO callback URL
# (<PROXY_BASE_URL>/sso/callback), so this must be reachable by staff browsers,
# not "localhost".
PROXY_BASE_URL=http://<gateway-host>:4000
# From Keycloak: Clients -> cis-ollama-fleet -> Credentials tab, after you
# create the client per docs/ADMIN_SSO_SETUP.md.
GENERIC_CLIENT_ID=cis-ollama-fleet
GENERIC_CLIENT_SECRET=change-me-from-keycloak-client-credentials-tab
